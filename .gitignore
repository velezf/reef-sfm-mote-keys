# Python / uv
.venv/
__pycache__/
*.pyc
.python-version.local
.uv/

# Jupyter
.ipynb_checkpoints/

# Binary products — live on EC2 / local disk, never committed
# (individual globs below catch strays anywhere in the tree; products/ is the
# canonical local pull target and excluded wholesale)
products/

# Raw data cache — gitignored per workflow doc, .gitkeep sentinel only
data/raw/*
!data/raw/.gitkeep

# Processed intermediates — large, regenerable
data/processed/*
!data/processed/.gitkeep

# Metashape project files and dense products live on EC2, not in the repo.
# These globs are defensive in case anything is rsynced down.
*.psx
*.psz
*.files/
*.zip
*.las
*.laz
*.ply
*.obj
*.tif
*.tiff

# Figures — keep .gitkeep, accept committed PNG/SVG outputs explicitly
figures/scratch/
figures/*.psd

# macOS / editor cruft
.DS_Store
.vscode/
.idea/
*.swp
# Append these lines to the .gitignore created in Chat 1.
# They cover artifacts produced by the AWS infrastructure layer.

# Auto-generated by scripts in scripts/aws/. Contains resource IDs that
# aren't secret but aren't useful to anyone else, and pollute git diffs.
# docs/aws-resources.md contains instance ID / EIP / ENI MAC — do not track.
docs/aws-resources.md
config/aws-config.sh

# Bulk contact sheets — only representative samples are tracked
data/figures/contact_sheets/*/contact_sheet_*.jpg
!data/figures/contact_sheets/*/contact_sheet_001.jpg
!data/figures/contact_sheets/*/contact_sheet_046.jpg
!data/figures/contact_sheets/*/contact_sheet_091.jpg

# Harvested pipeline artifacts — large, regenerable via scripts/harvest_artifacts.sh
artifacts/**
!artifacts/MANIFEST.md
!artifacts/**/.gitkeep

# P13HMEON comparison-only store (firewall 325dbc7): published USGS reference
# DEMs + the topographic-complexity values table. Read-only on disk; NEVER a
# pipeline input and NEVER committed (re-fetchable from DOI 10.5066/P13HMEON).
data/comparison-only/
